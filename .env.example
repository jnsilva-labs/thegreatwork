# Awareness Paradox site environment example

# --- AI (tarot interpretations) ---
# The tarot interpret route uses the Vercel AI Gateway with OIDC auth.
# No provider API keys are required. For local dev, run:
#   vercel link            (once)
#   vercel env pull .env.local
# This writes VERCEL_OIDC_TOKEN (short-lived, ~12h). When local AI calls
# start returning 503 SHARED_KEY_UNAVAILABLE, re-pull:
#   vercel env pull .env.local --yes
# CAUTION: `vercel env pull` REPLACES .env.local. Keep any manually added
# local-only values in .env.development.local so pulls don't erase them.
# VERCEL_OIDC_TOKEN=   (populated by `vercel env pull`; never set manually)

# --- Astrology service ---
# ASTRO_SERVICE_URL=http://localhost:3001
# Vercel-only secret that signs the soft per-browser AI allowance.
# DAILY_USAGE_COOKIE_SECRET=
# Must be the same value in Vercel and Render; never expose it to browsers.
# ASTRO_SERVICE_SECRET=
# OPENAI_API_KEY=

# --- Public links used in newsletter/archive pages ---
NEXT_PUBLIC_SUBSTACK_URL=

# --- Optional PostHog analytics ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Vercel Blob (starter guide PDF delivery) ---
# BLOB_READ_WRITE_TOKEN=

# Private token appended to the starter-guide link in your welcome email
STARTER_GUIDE_ACCESS_TOKEN=
