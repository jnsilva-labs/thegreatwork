# Awareness Paradox site environment example

# --- AI readings (tarot interpretations + astrology readings) ---
# Both services call the Anthropic Claude API directly.
ANTHROPIC_API_KEY=
# Optional per-service model overrides (default: claude-sonnet-5-5).
# Alternatives: claude-opus-5-5 (premium), claude-haiku-5-5 (cheapest).
# ANTHROPIC_TAROT_MODEL=claude-sonnet-5-5
# ANTHROPIC_ASTRO_MODEL=claude-sonnet-5-5
# CAUTION: `vercel env pull` REPLACES .env.local. Keep any manually added
# local-only values in .env.development.local so pulls don't erase them.

# --- Astrology ---
# Chart math runs in-process (astronomy-engine); no external service or
# secret is needed. Vercel-only secret that signs the soft per-browser AI
# allowance:
# DAILY_USAGE_COOKIE_SECRET=

# --- Public links used in newsletter/archive pages ---
NEXT_PUBLIC_SUBSTACK_URL=

# --- Optional PostHog analytics ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Vercel Blob (starter guide PDF delivery) ---
# BLOB_READ_WRITE_TOKEN=

# Private token appended to the starter-guide link in your welcome email
STARTER_GUIDE_ACCESS_TOKEN=
